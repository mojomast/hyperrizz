{
  "name": "hyperframes-calibration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "hyperframes lint .build",
    "check": "hyperframes check .build",
    "seek-check": "node scripts/seek-check.mjs",
    "stills": "hyperframes snapshot .build --at 0.3,1.3 --no-end --output previews/keyframes",
    "render": "node scripts/render-safe.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "hyperframes": "0.9.23",
    "esbuild": "0.25.12",
    "puppeteer-core": "25.16.0"
  }
}
